# macOS Finder metadata — never part of the project.
.DS_Store

# Local Stage 3C-R training virtualenv (~1.1 GB). Not part of the project; recreate locally if needed.
.venv-stage3cr-training/

# Stage 3F.6 evaluation corpus: a deterministic build product, not a source of truth.
# The durable Git record is the generator + manifest + content hash + documentation.
# Regenerate with:  cd platform/game-agnostic && npm run stage3f6:generate
# Expected content hash: sha256:33f817a54fc1d8988173af83d79409d27cbaf4b7dcbcb2f1f4a12d54f5961b58
platform/game-agnostic/artifacts/stage3f6-prediction-reliability/evaluation-corpus.jsonl.gz

