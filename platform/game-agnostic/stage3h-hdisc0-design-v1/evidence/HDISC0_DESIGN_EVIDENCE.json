 "explanations": {
  "A_incorrectRiskDifferencesBetweenLegalActions": {
   "status": "SUPPORTED",
   "kind": "LEARNED_MODEL_ERROR (observed against OFFLINE_EVALUATOR_FACT labels)",
   "evidence": {
    "orderingErrorsValidation": "34 of 39",
    "orderingErrorsExplorationOutOfBag": "48 of 55",
    "pairwiseCorrectlyOrderedValidation": 0.8013,
    "pairwiseCorrectlyOrderedSameTypeValidation": 0.8462
   },
   "reading": "The frozen estimate assigns a lower risk to an unsafe action than to every safe alternative in most failing menus. This is an observation about the model, not an explanation of why."
  },
  "B_sharedModellingBiasAmongBags": {
   "status": "SUPPORTED_AS_COMMON_MODE_ERROR; CAUSE_NOT_IDENTIFIED",
   "kind": "OBSERVATION about the ensemble",
   "evidence": {
    "validationOrderingErrorsByBagsOf10PreferringTheSafeAlternative": {
     "0": 17,
     "1": 5,
     "2": 2,
     "3": 2,
     "4": 2,
     "5": 4,
     "6": 1,
     "7": 1
    },
    "validationUnanimous": 17,
    "validationAtMost2Of10": 24,
    "validationMajorityOfBagsPreferTheSafeAlternative": 2,
    "explorationOutOfBagUnanimousAmongBagsUsed": 31,
    "explorationOutOfBagOrderingErrors": 48,
    "explorationMedianBoundGapInSpreads": 2.6046
   },
   "reading": "The bags share one learner, one feature set, one label and overlapping families, so their agreement does not make an estimate more likely to be right. Common-mode error is established. Whether its source is the learner and objective (correctable) or the features (not correctable by any learner on them) is NOT distinguishable from existing evidence."
  },
  "C_publicObservationEquivalenceHidingSafetyRelevantDifferences": {
   "status": "ESTABLISHED_FOR_OUTCOMES_OF_SINGLE_WORLDS; NOT_ESTABLISHED_FOR_CHOOSING_A_ROBUSTLY_SAFE_ACTION",
   "kind": "OFFLINE_EVALUATOR_FACT for the outcome dependence; PUBLIC_IDENTIFIABILITY unresolved",
   "evidence": {
    "validationFailingChoiceCatastrophicInSomeMembersOnly": 33,
    "validationFailingChoiceCatastrophicInEveryMember": 6,
    "validationFailuresOnTwinWorldsOnly": 19,
    "validationFailuresOnTheBaseWorld": 20,
    "explorationOutOfBagFailingChoiceCatastrophicInSomeMembersOnly": 41,
    "explorationOutOfBagFailuresOnTwinWorldsOnly": 18,
    "allActionsValidation": {
     "actions": 5304,
     "neverCatastrophic": 2715,
     "catastrophicInSomeMembersOnly": 1653,
     "catastrophicInEveryMember": 936,
     "shareOfCatastrophicActionsThatAreHiddenStateDependent": 0.6385
    },
    "allActionsExploration": {
     "actions": 8895,
     "neverCatastrophic": 4337,
     "catastrophicInSomeMembersOnly": 2862,
     "catastrophicInEveryMember": 1696,
     "shareOfCatastrophicActionsThatAreHiddenStateDependent": 0.6279
    },
    "menusWithIdenticalFeatureRowsAndDifferentIntroductionOutcome": 4,
    "explorationMenus": 1000,
    "crossClassIdenticalRows": 0,
    "classesWithARobustlySafeAction": "600 of 600 validation; 1000 of 1000 exploration"
   },
   "reading": "Hidden state decides the outcome of a given action in a given world: most catastrophic actions are catastrophic in some public-equivalent worlds and not others. That makes the per-world outcome publicly unpredictable. It does not by itself make the robust question unanswerable: every class contains an action that is safe in all sampled members. Whether that action can be told apart from public information is the open question. A demonstrated limit exists only for the few menus whose actions have identical feature rows."
  },
  "distinguishability": {
   "A_from_B": "not separate hypotheses: B describes how the errors in A are distributed across the ensemble",
   "B_from_C": "NOT_DISTINGUISHABLE_FROM_EXISTING_EVIDENCE. Both predict confident, unanimous, wrong within-menu orderings. Separating them needs a different learner evaluated on fresh classes (B predicts it can improve; a strict C predicts a ceiling) and a twin-consistency measurement.",
   "whatExistingEvidenceCannotDo": "show that an evaluator-safe action is publicly identifiable; show that it is not"
  }
 },
