{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "turn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "energy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "known": {
            "type": "boolean"
          },
          "rescued": {
            "type": "boolean"
          },
          "risk": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": [
          "id",
          "known",
          "rescued",
          "risk"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "turn",
    "maxTurns",
    "energy",
    "sites"
  ],
  "additionalProperties": false
}
