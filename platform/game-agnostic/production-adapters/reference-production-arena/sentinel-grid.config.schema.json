{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "observationSize": {
      "type": "integer",
      "minimum": 512,
      "maximum": 8192,
      "default": 2048
    },
    "legalActionCount": {
      "type": "integer",
      "minimum": 32,
      "maximum": 512,
      "default": 96
    },
    "maxTicks": {
      "type": "integer",
      "minimum": 64,
      "maximum": 2048,
      "default": 256
    },
    "boardSize": {
      "type": "integer",
      "minimum": 16,
      "maximum": 256,
      "default": 64
    }
  },
  "required": [
    "observationSize",
    "legalActionCount",
    "maxTicks",
    "boardSize"
  ],
  "additionalProperties": false
}
