{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "maxTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "boardSize": {
      "type": "integer",
      "minimum": 16,
      "maximum": 256
    },
    "score": {
      "type": "object",
      "properties": {
        "alpha": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "beta": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "alpha",
        "beta"
      ],
      "additionalProperties": false
    },
    "privateSignals": {
      "type": "object",
      "properties": {
        "alpha-0": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "alpha-1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "beta-0": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "beta-1": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "alpha-0",
        "alpha-1",
        "beta-0",
        "beta-1"
      ],
      "additionalProperties": false
    },
    "hazards": {
      "type": "array",
      "minItems": 16,
      "maxItems": 256,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    }
  },
  "required": [
    "tick",
    "maxTicks",
    "boardSize",
    "score",
    "privateSignals",
    "hazards"
  ],
  "additionalProperties": false
}
