{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-grid.local/schemas/adapter-lock.schema.json",
  "title": "Sentinel Grid Production Adapter Lock",
  "type": "object",
  "required": [
    "lockVersion",
    "contractVersion",
    "kernelVersion",
    "packages",
    "lockHash"
  ],
  "properties": {
    "lockVersion": {
      "const": 2
    },
    "contractVersion": {
      "const": 1
    },
    "kernelVersion": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "packageName",
          "packageVersion",
          "packageSha256",
          "entry",
          "entrySha256",
          "configSchema",
          "configSchemaSha256",
          "gameId",
          "adapterId",
          "adapterVersion",
          "factoryExport",
          "certificationProfile",
          "snapshotFormats",
          "snapshotFormatsHash",
          "configuration",
          "configurationHash"
        ],
        "properties": {
          "packageName": {
            "type": "string",
            "minLength": 1
          },
          "packageVersion": {
            "type": "string",
            "minLength": 1
          },
          "packageSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entry": {
            "type": "string",
            "minLength": 1
          },
          "entrySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "configSchema": {
            "type": "string",
            "minLength": 1
          },
          "configSchemaSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "gameId": {
            "type": "string",
            "minLength": 1
          },
          "adapterId": {
            "type": "string",
            "minLength": 1
          },
          "adapterVersion": {
            "type": "string",
            "minLength": 1
          },
          "factoryExport": {
            "type": "string",
            "minLength": 1
          },
          "certificationProfile": {
            "type": "string",
            "minLength": 1
          },
          "snapshotFormats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "formatId",
                "formatVersion",
                "schema",
                "schemaSha256",
                "importerMethod"
              ],
              "properties": {
                "formatId": {
                  "type": "string",
                  "minLength": 1
                },
                "formatVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "schema": {
                  "type": "string",
                  "minLength": 1
                },
                "schemaSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "importerMethod": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "snapshotFormatsHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "configuration": {
            "type": "object"
          },
          "configurationHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "lockHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
