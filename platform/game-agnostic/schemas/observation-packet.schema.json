{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-grid/observation-packet/v1",
  "type": "object",
  "required": ["contractVersion", "gameId", "schemaId", "schemaVersion", "observerId", "sequence", "features", "metadata"],
  "properties": {
    "contractVersion": { "const": 1 },
    "gameId": { "type": "string", "minLength": 1 },
    "schemaId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "observerId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "features": { "type": "array", "items": { "type": "number" } },
    "featureShape": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "metadata": { "type": "object" }
  }
}
