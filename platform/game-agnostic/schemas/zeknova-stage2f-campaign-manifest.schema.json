{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZekNova Stage 2F Runtime-Bound Campaign Manifest",
  "type": "object",
  "required": [
    "campaignManifestVersion",
    "stage2fCampaignId",
    "sentinelRuntimeId",
    "generatedRuntimeProvenanceId",
    "campaignStartTime",
    "recordSchemaVersion",
    "collectorSchemaVersion",
    "sessionManifestVersion",
    "certificationPolicyVersion",
    "qualificationThresholdPolicy",
    "qualificationThresholdPolicyHash",
    "campaignMode",
    "campaignState",
    "qualificationEligible",
    "authorityTier",
    "authority",
    "campaignManifestHash"
  ],
  "additionalProperties": true,
  "properties": {
    "campaignManifestVersion": { "const": 1 },
    "stage2fCampaignId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sentinelRuntimeId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "generatedRuntimeProvenanceId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "campaignStartTime": { "type": "string", "format": "date-time" },
    "recordSchemaVersion": { "const": 2 },
    "collectorSchemaVersion": { "const": 2 },
    "sessionManifestVersion": { "const": 2 },
    "campaignMode": { "enum": ["QUALIFICATION", "DRY_RUN"] },
    "campaignState": { "enum": ["PREPARED", "ACTIVE", "CLOSED", "STALE"] },
    "qualificationEligible": { "type": "boolean" },
    "authorityTier": { "const": "R0" },
    "campaignManifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
