{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-grid/snapshot-envelope",
  "type": "object",
  "properties": {
    "snapshotContractVersion": {
      "const": 1
    },
    "gameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "adapterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "formatId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1
    },
    "observers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "payload": {},
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "snapshotContractVersion",
    "gameId",
    "adapterId",
    "adapterVersion",
    "snapshotId",
    "formatId",
    "formatVersion",
    "observers",
    "payload",
    "metadata"
  ],
  "additionalProperties": false
}
