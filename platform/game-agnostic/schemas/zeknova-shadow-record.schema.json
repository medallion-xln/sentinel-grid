{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZekNova Sustained Shadow Record",
  "type": "object",
  "required": [
    "shadowRecordVersion",
    "captureId",
    "qualificationIdentity",
    "fixtureHash",
    "context",
    "sourceStateHash",
    "observerId",
    "simulations",
    "selectedActionKey",
    "legacySelectedActionKey",
    "agreement",
    "pass",
    "authority",
    "recordHash"
  ],
  "additionalProperties": true,
  "properties": {
    "shadowRecordVersion": {
      "const": 2
    },
    "captureId": {
      "type": "string",
      "minLength": 1
    },
    "qualificationIdentity": {
      "type": "object",
      "required": ["identityEnvelopeVersion", "sentinelRuntimeId", "generatedRuntimeProvenanceId", "stage2fCampaignId", "sessionId", "samplingIdentity", "recordSchemaVersion", "collectorSchemaVersion", "authorityTier", "evidenceMode", "qualificationEligible"],
      "properties": {
        "identityEnvelopeVersion": { "const": 1 },
        "sentinelRuntimeId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "generatedRuntimeProvenanceId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "stage2fCampaignId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sessionId": { "type": "string", "minLength": 1 },
        "samplingIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "recordSchemaVersion": { "const": 2 },
        "collectorSchemaVersion": { "const": 2 },
        "authorityTier": { "const": "R0" },
        "evidenceMode": { "enum": ["QUALIFICATION", "DRY_RUN"] },
        "qualificationEligible": { "type": "boolean" }
      }
    },
    "fixtureHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceStateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observerId": {
      "type": "string",
      "minLength": 1
    },
    "simulations": {
      "type": "integer",
      "minimum": 1
    },
    "pass": {
      "type": "boolean"
    },
    "recordHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
