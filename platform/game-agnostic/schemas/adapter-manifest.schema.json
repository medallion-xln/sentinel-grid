{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel-grid/adapter-manifest/v1",
  "type": "object",
  "required": ["contractVersion", "gameId", "adapterId", "adapterVersion", "deterministic", "observationSchemas", "capabilities", "authority"],
  "properties": {
    "contractVersion": { "const": 1 },
    "gameId": { "type": "string", "minLength": 1 },
    "adapterId": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "deterministic": { "const": true },
    "observationSchemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schemaId", "schemaVersion", "variableSize"],
        "properties": {
          "schemaId": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "variableSize": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["imperfectInformation", "stochasticTransitions", "simultaneousActions", "variableObservationSize"],
      "properties": {
        "imperfectInformation": { "type": "boolean" },
        "stochasticTransitions": { "type": "boolean" },
        "simultaneousActions": { "type": "boolean" },
        "variableObservationSize": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["tier", "executionInterface"],
      "properties": {
        "tier": { "const": "R0" },
        "executionInterface": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
