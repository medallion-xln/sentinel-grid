{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-grid.local/schemas/adapter-package-metadata.schema.json",
  "title": "Sentinel Grid Adapter Package Metadata",
  "type": "object",
  "required": [
    "entry",
    "gameId",
    "adapterId",
    "adapterVersion",
    "configSchema",
    "certificationProfile",
    "snapshotFormats"
  ],
  "properties": {
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "factoryExport": {
      "type": "string",
      "minLength": 1,
      "default": "createAdapter"
    },
    "gameId": {
      "type": "string",
      "minLength": 1
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "configSchema": {
      "type": "string",
      "minLength": 1
    },
    "certificationProfile": {
      "enum": [
        "universal-r0",
        "production-r0",
        "imperfect-information-r0",
        "stochastic-r0"
      ]
    },
    "snapshotFormats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "formatId",
          "formatVersion",
          "schema"
        ],
        "properties": {
          "formatId": {
            "type": "string",
            "minLength": 1
          },
          "formatVersion": {
            "type": "integer",
            "minimum": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "importerMethod": {
            "type": "string",
            "minLength": 1,
            "default": "importSnapshot"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
