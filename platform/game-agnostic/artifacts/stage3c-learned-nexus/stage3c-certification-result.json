        "rule": "a node whose removal disconnects reachable structure"
      },
      {
        "id": "CYCLE",
        "rule": "a directed cycle among depends-edges"
      },
      {
        "id": "REDUNDANCY",
        "rule": "two or more live substitutes for the same failed node"
      },
      {
        "id": "MULTI_HOP",
