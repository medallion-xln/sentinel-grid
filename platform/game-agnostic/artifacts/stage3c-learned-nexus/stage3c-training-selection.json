    },
    {
      "id": "MULTI_HOP",
      "rule": "dependency depth >= 3"
    },
    {
      "id": "DISTRIBUTED_VALUE",
      "rule": "value spread across three or more structural nodes"
    },
    {
      "id": "CASCADING_FAILURE",
      "rule": "an unavailable node with two or more dependents"
    },
    {
      "id": "RESOURCE_ALLOCATION",
      "rule": "energy below the cost of the open work"
    },
    {
      "id": "INTERVENTION_CHOICE",
      "rule": "two or more distinct action types legal on structural targets"
    },
    {
      "id": "NEGATIVE_CONTROL_NO_RELATIONS",
